{
  "rules": {
    // Default deny. Nothing outside the paths below is readable or writable.
    ".read": false,
    ".write": false,

    "rooms": {
      // No read/write at this level: the rooms tree cannot be listed. A client
      // must already know a room code to reach anything. Enumerating the whole
      // tree in one request was the previous behavior.
      "$roomId": {
        // Access cascades to every descendant (players, teams, words,
        // gameState, status), which is what the app writes through.
        // The character class mirrors RoomCode.alphabet exactly:
        // A-Z without I and O, digits 2-9.
        ".read": "$roomId.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".write": "$roomId.matches(/^[A-HJ-NP-Z2-9]{6}$/)",

        // .validate runs on the merged result of every write, so leaf and
        // multi-path updates pass as long as the room stays whole; it never
        // runs on deletes, so leaving and closing rooms are unaffected.
        // Length caps mirror RoomLimits in GameCore. Every level below lists
        // exactly the fields GameRoom and its children encode; anything else
        // is refused by its $other rule.
        ".validate": "newData.hasChildren(['id', 'hostId', 'status', 'settings', 'createdAt']) && newData.child('id').val() === $roomId",
        // id, hostId and createdAt are written once, at creation.
        "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "hostId": { ".validate": "newData.isString() && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "schemaVersion": { ".validate": "newData.isNumber() && newData.val() >= 1" },
        "status": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "settings": {
          ".validate": "newData.hasChildren()",
          "maxTeams": { ".validate": "newData.isNumber()" },
          "playersPerTeam": { ".validate": "newData.isNumber()" },
          "wordsPerPlayer": { ".validate": "newData.isNumber()" },
          "roundDuration": { ".validate": "newData.isNumber()" },
          "isSkippingEnabled": { ".validate": "newData.isBoolean()" },
          "skipPenalty": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "isAutomaticWords": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },

        "players": {
          "$playerId": {
            // Also refuses a lone isConnected write for a player who has
            // already left, which would otherwise recreate a partial node.
            // A new player may appear only while the lobby is open; an
            // existing one (a returning device) may still be updated. Team
            // membership is fixed once the game starts: checked here rather
            // than on teamId, since leaving a team deletes that leaf and
            // .validate never runs on a delete.
            ".validate": "newData.hasChildren(['id', 'deviceId', 'name', 'joinedAt']) && newData.child('id').val() === $playerId && (data.exists() || newData.parent().parent().child('status').val() === 'waiting' || newData.parent().parent().child('status').val() === 'setup') && (newData.child('teamId').val() === data.child('teamId').val() || newData.parent().parent().child('status').val() === 'waiting' || newData.parent().parent().child('status').val() === 'setup')",
            // id, deviceId and joinedAt are written once, when the player joins.
            "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
            "deviceId": { ".validate": "newData.isString() && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())" },
            "joinedAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "teamId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "isReady": { ".validate": "newData.isBoolean()" },
            "hasSubmittedWords": { ".validate": "newData.isBoolean()" },
            "isConnected": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },

        "teams": {
          "$teamId": {
            ".validate": "newData.hasChildren(['id', 'name', 'colorHex']) && newData.child('id').val() === $teamId",
            "id": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "colorHex": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "createdAt": { ".validate": "newData.isNumber()" },
            // Stored as an index-keyed list of player ids.
            "playerIds": {
              "$index": { ".validate": "$index.matches(/^[0-9]{1,3}$/) && newData.isString() && newData.val().length <= 64" }
            },
            "$other": { ".validate": false }
          }
        },

        "words": {
          "$wordId": {
            ".validate": "newData.hasChildren(['id', 'text', 'addedByPlayerId']) && newData.child('id').val() === $wordId",
            "id": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
            "addedByPlayerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "$other": { ".validate": false }
          }
        },

        // Deliberately open below this level: the game state is versioned
        // (schemaVersion) and transactions carry unknown keys through, so a
        // newer build can add fields without a rules change.
        "gameState": {
          ".validate": "newData.hasChildren(['currentRound', 'currentTeamIndex', 'phase', 'roundDuration'])",
          "schemaVersion": { ".validate": "newData.isNumber() && newData.val() >= 1" }
        },

        "$other": { ".validate": false }
      }
    },

    "feedback": {
      // Write-only and create-only: nobody can read feedback back, and an
      // existing entry can be neither replaced nor deleted.
      "$feedbackId": {
        ".write": "!data.exists() && $feedbackId.length <= 64",
        ".validate": "newData.hasChildren(['id', 'category', 'message', 'createdAt']) && newData.child('id').val() === $feedbackId",
        "id": { ".validate": "newData.isString()" },
        "category": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "message": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000" },
        "appVersion": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "build": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "systemVersion": { ".validate": "newData.isString() && newData.val().length <= 256" },
        "deviceModel": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "locale": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "deviceId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
